{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/prospective_candidate_signal.schema.json",
  "title": "ProspectiveCandidateSignalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "source_run_id", "source_run_sha256", "source_snapshot_sha256", "signal_date", "lane", "execution_mode", "generated_at_utc", "source_evidence_asof_utc", "candidate_frozen_before_outcome", "candidate_status", "blocking_reasons", "earliest_legal_execution", "same_day_close_signal_claim", "protocol_version", "protocol_sha256", "model_disposition_sha256", "arms", "source_features", "broker_order_object", "prospective_unvalidated", "decision_eligible", "counterfactual_only", "paper_positions", "real_orders"],
  "properties": {
    "schema_version": {"const": "mso-prospective-candidate-signal-v1"},
    "candidate_id": {"type": "string"},
    "source_run_id": {"type": "string"},
    "source_run_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "signal_date": {"type": "string", "format": "date"},
    "lane": {"enum": ["preclose", "postclose"]},
    "execution_mode": {"const": "PROSPECTIVE_CANDIDATE_SHADOW"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "source_evidence_asof_utc": {"type": "string", "format": "date-time"},
    "candidate_frozen_before_outcome": {"type": "boolean"},
    "candidate_status": {"enum": ["FROZEN", "BLOCKED"]},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "earliest_legal_execution": {"enum": ["post_candidate_15_47_sip_quote", "next_trading_day_open"]},
    "same_day_close_signal_claim": {"const": false},
    "protocol_version": {"const": "prospective-candidate-protocol-v1"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_disposition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "arms": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "source_features": {"type": "array", "items": {"type": "object"}},
    "broker_order_object": {"type": "null"},
    "prospective_unvalidated": {"const": true},
    "decision_eligible": {"const": false},
    "counterfactual_only": {"const": true},
    "paper_positions": {"const": 0},
    "real_orders": {"const": 0}
  }
}
