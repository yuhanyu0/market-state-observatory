{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/observation_features.schema.json",
  "title": "ObservationFeaturesV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "feature_set_version", "evidence_grade", "features"],
  "properties": {
    "schema_version": {"const": "mso-observation-features-v2"},
    "run_id": {"type": "string", "minLength": 1},
    "feature_set_version": {"const": "observation-features-v2"},
    "evidence_grade": {"const": "completed_run_point_in_time"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "feature_set_version", "theme_id", "symbol_scope", "observation_point", "event_time_utc", "observed_at_utc", "data_max_timestamp", "availability_status", "calculation_exists", "evidence_quality", "model_input_eligible", "not_applicable_reason", "value", "units", "source_snapshot_refs", "source_snapshot_sha256", "calculation_sha256"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1},
          "feature_set_version": {"const": "observation-features-v2"},
          "theme_id": {"type": "string", "minLength": 1},
          "symbol_scope": {"type": "string", "minLength": 1},
          "observation_point": {"type": "string", "minLength": 1},
          "event_time_utc": {"type": "string", "format": "date-time"},
          "observed_at_utc": {"type": "string", "format": "date-time"},
          "data_max_timestamp": {"type": "string", "format": "date-time"},
          "availability_status": {"enum": ["AVAILABLE", "NOT_AVAILABLE", "NOT_APPLICABLE", "NOT_CALIBRATED"]},
          "calculation_exists": {"type": "boolean"},
          "evidence_quality": {"enum": ["VALID", "STALE_SOURCE", "INCOMPLETE_SOURCE", "BASELINE_ONLY", "NOT_APPLICABLE"]},
          "model_input_eligible": {"type": "boolean"},
          "not_applicable_reason": {"type": ["string", "null"]},
          "value": {},
          "units": {"type": "string", "minLength": 1},
          "source_snapshot_refs": {"type": "array", "items": {"type": "string"}},
          "source_snapshot_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "calculation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
