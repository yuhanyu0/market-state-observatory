{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/daily_report_status.schema.json", "title": "DailyReportStatusV1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "execution_mode", "source_run_unchanged", "output_directory", "report_sha256", "candidate_replay_executed", "paper_positions", "real_orders"],
  "properties": {"schema_version": {"const": "mso-daily-report-status-v1"}, "run_id": {"type": "string"}, "status": {"enum": ["COMPLETE", "BLOCKED", "FAILED"]}, "execution_mode": {"enum": ["OBSERVATION_ONLY", "CANDIDATE_REPLAY", "PROSPECTIVE_CANDIDATE_SHADOW", "MODEL_SHADOW"]}, "source_run_unchanged": {"const": true}, "output_directory": {"type": "string"}, "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "candidate_replay_executed": {"type": "boolean"}, "paper_positions": {"const": 0}, "real_orders": {"const": 0}}
}
