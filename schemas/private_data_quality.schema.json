{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/private_data_quality.schema.json",
  "title": "PrivateDataQuality",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "run_id", "trading_date", "run_mode", "process_success",
    "production_release", "data_quality_pass", "publication_eligible",
    "schema_validation_pass", "secret_scan_pass", "forbidden_path_scan_pass",
    "counts_toward_20_day_gate", "counts_toward_model_shadow",
    "publication_as_formal", "stream_message_drop_count",
    "observation_capture_rate", "quote_ready_rate", "trade_ready_rate",
    "bar_ready_rate", "vwap_ready_rate",
    "paper_positions", "real_orders", "themes"
  ],
  "properties": {
    "schema_version": {"const": "mso-private-data-quality-v3"},
    "run_id": {"type": "string", "minLength": 1},
    "trading_date": {"type": "string", "format": "date"},
    "run_mode": {"enum": ["FORMAL_DATA_SHADOW", "DATA_CAPTURE_REHEARSAL"]},
    "process_success": {"type": "boolean"},
    "production_release": {"type": "boolean"},
    "data_quality_pass": {"type": "boolean"},
    "publication_eligible": {"type": "boolean"},
    "counts_toward_20_day_gate": {"type": "boolean"},
    "counts_toward_model_shadow": {"const": false},
    "publication_as_formal": {"type": "boolean"},
    "stream_message_drop_count": {"type": "integer", "minimum": 0},
    "observation_capture_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "quote_ready_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "trade_ready_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "bar_ready_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "vwap_ready_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "schema_validation_pass": {"type": "boolean"},
    "secret_scan_pass": {"type": "boolean"},
    "forbidden_path_scan_pass": {"type": "boolean"},
    "paper_positions": {"const": 0},
    "real_orders": {"const": 0},
    "themes": {"type": "array"}
  }
}
