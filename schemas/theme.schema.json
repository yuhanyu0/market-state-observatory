{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/theme.schema.json",
  "title": "Theme",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "theme_id",
    "display_name",
    "tracker_etf",
    "status"
  ],
  "properties": {
    "theme_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "tracker_etf": {
      "type": "string"
    },
    "benchmark": {
      "type": "string"
    },
    "constituents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}
