{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuhanyu0.github.io/market-state-observatory/schemas/evidence_graph.schema.json",
  "title": "EvidenceGraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "graph_id",
    "as_of_utc",
    "nodes",
    "edges"
  ],
  "properties": {
    "graph_id": {
      "type": "string"
    },
    "as_of_utc": {
      "type": "string",
      "format": "date-time"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "observation",
              "estimate",
              "claim",
              "action",
              "boundary"
            ]
          },
          "label": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "relation"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "supports",
              "contradicts",
              "derived_from",
              "invalidates",
              "requires",
              "blocks"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  }
}
